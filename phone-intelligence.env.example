# Phone Intelligence & Scam Checker
# Env vars are optional fallbacks. Prefer saving keys from the Phone Check UI:
# Dashboard → Phone Check → Manage API keys

# Hash salt for phone numbers (change in production)
PHONE_HASH_SALT=change-me-to-a-long-random-string
PHONE_DEFAULT_COUNTRY=EG
# Set to false to disable free DuckDuckGo HTML search
PHONE_DDG_SEARCH=true

# Optional env fallbacks (UI-saved DB credentials take priority)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ABSTRACT_API_KEY=
NUMVERIFY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
