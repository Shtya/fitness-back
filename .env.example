PORT=3030
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,https://so7bafit.com,https://www.so7bafit.com
JWT_SECRET=
JWT_EXPIRE=1d
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_POOL_SIZE=4
# Set to false to skip Redis entirely (WhatsApp locks and cache soft-disable)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=
WHATSAPP_PROVIDER=wppconnect
WHATSAPP_MEDIA_ROOT=uploads/whatsapp-media
CHROME_EXECUTABLE_PATH=
AI_REPLY_CHATGPT_URL=https://chatgpt.com/
AI_REPLY_HEADLESS=true
AI_REPLY_EXECUTABLE_PATH=
AI_REPLY_NAVIGATION_TIMEOUT_MS=60000
AI_REPLY_RESPONSE_TIMEOUT_MS=120000
AI_REPLY_MAX_CONCURRENCY=2
AI_REPLY_RATE_LIMIT_PER_MINUTE=10
AI_REPLY_MAX_PROMPT_LENGTH=24000
AI_REPLY_USER_AGENT=
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:8000
TRANSCRIPTION_SERVICE_API_KEY=
TRANSCRIPTION_TIMEOUT_MS=1800000
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
ASSEMBLYAI_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRANSCRIPTION_CREDENTIAL_ENCRYPTION_KEY=
# Meta WhatsApp Cloud API (Lead Scout) — optional dedicated AES key (32-byte base64). Falls back to JWT-derived key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_WHATSAPP_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v21.0
# Public API origin used to build the Meta webhook callback URL shown in the admin UI
# Example: https://api.so7bafit.com   OR   https://api.so7bafit.com/api/v1
META_WHATSAPP_PUBLIC_API_URL=
