PORT=3030
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,https://so7bafit.com,https://www.so7bafit.com
JWT_SECRET=
JWT_EXPIRE=1d
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_POOL_SIZE=4
# Set to false to skip Redis entirely (WhatsApp locks and cache soft-disable)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=
WHATSAPP_PROVIDER=baileys
WHATSAPP_MEDIA_ROOT=uploads/whatsapp-media
CHROME_EXECUTABLE_PATH=
AI_REPLY_CHATGPT_URL=https://chatgpt.com/
AI_REPLY_HEADLESS=true
AI_REPLY_EXECUTABLE_PATH=
AI_REPLY_NAVIGATION_TIMEOUT_MS=60000
AI_REPLY_RESPONSE_TIMEOUT_MS=120000
AI_REPLY_MAX_CONCURRENCY=2
AI_REPLY_RATE_LIMIT_PER_MINUTE=10
AI_REPLY_MAX_PROMPT_LENGTH=24000
AI_REPLY_USER_AGENT=
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:8000
TRANSCRIPTION_SERVICE_API_KEY=
TRANSCRIPTION_TIMEOUT_MS=1800000
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
ASSEMBLYAI_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRANSCRIPTION_CREDENTIAL_ENCRYPTION_KEY=
# Meta WhatsApp Cloud API (Lead Scout) — optional dedicated AES key (32-byte base64). Falls back to JWT-derived key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_WHATSAPP_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v21.0
# Public API origin used to build the Meta webhook callback URL shown in the admin UI
# Example: https://api.so7bafit.com   OR   https://api.so7bafit.com/api/v1
META_WHATSAPP_PUBLIC_API_URL=

# ─── AI Content Automation Studio ─────────────────────────────
# Optional dedicated AES-256 key (32-byte base64). Falls back to JWT-derived key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CONTENT_STUDIO_ENCRYPTION_KEY=
# Public origin for Instagram image_url (must be HTTPS reachable by Meta)
# Example: https://api.so7bafit.com
AI_CONTENT_STUDIO_PUBLIC_BASE_URL=
AI_CONTENT_STUDIO_UPLOAD_DIR=
# AI Content Studio uses Gemini + Nano Banana Pro. This key is auto-applied on first open.
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
# GROQ_API_KEY already defined above
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ─── Email Memo (Gmail → AI → WhatsApp) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Google callback, or the API origin only (callback path is appended).
# Local:  http://localhost:8083
# Live:   https://api.so7bafit.com
GOOGLE_REDIRECT_URI=https://api.so7bafit.com/api/v1/email-memo/gmail/callback
# projects/YOUR_PROJECT/topics/gmail-push  (optional; polling is used when empty)
GMAIL_PUBSUB_TOPIC=
# Optional shared secret appended as ?token= on the Pub/Sub push URL
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Public API origin if GOOGLE_REDIRECT_URI is not set
EMAIL_MEMO_PUBLIC_API_URL=
# Optional dedicated AES-256 key (32-byte base64). Falls back to WHATSAPP_SESSION_ENCRYPTION_KEY / JWT.
EMAIL_MEMO_ENCRYPTION_KEY=
WHATSAPP_SESSION_PATH=
EMAIL_MEMO_CUSTOM_AI_URL=
EMAIL_MEMO_CUSTOM_AI_KEY=
EMAIL_MEMO_CUSTOM_AI_MODEL=

# ─── Gold Intelligence ────────────────────────────────────────
# Never fabricate prices. Leave keys empty to use free delayed/official sources.
# FRED_API_KEY is optional (CSV fallback is used). Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional third-party metals API (x-access-token). Docs: https://www.goldapi.io/api-documentation
GOLDAPI_API_KEY=
# Set true only in development. DEMO DATA must never appear as LIVE.
GOLD_INTELLIGENCE_DEMO=false

